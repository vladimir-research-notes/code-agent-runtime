# Local Claude Code overrides (never commit personal/local settings)
.claude/settings.local.json

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/

# Build / packaging artifacts
build/
dist/
*.egg-info/
.eggs/

# Coverage / test artifacts
.coverage
.coverage.*
htmlcov/
coverage.xml

# Node (only static HTML is committed under site/)
node_modules/

# Secrets and credentials (never commit)
.env
.env.*
*.key
*.pem

# Model weights / large generated artifacts
*.bin
*.pt
*.onnx
*.gguf
*.safetensors
*.h5
*.ckpt

# Logs (the milestone runner writes per-milestone run/cost logs under logs/;
# these are local artifacts, not committed)
*.log
/logs/

# Trace output directory (the `run --trace` default destination). Specific
# example traces, if ever committed, should live elsewhere and be force-added.
/traces/

# Eval result/report artifacts (the `eval run --out/--report` and the report
# generator script write here). The canonical, committed result table lives in
# docs/RESULTS.md; these are reproducible blobs, not committed.
/results/

# OS / editor cruft
.DS_Store
*.swp
*~

.claude/settings.json
